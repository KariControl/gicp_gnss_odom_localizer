<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>pure_odometry_bringup</name>
  <version>0.3.0</version>
  <description>Bringup for the GICP LiDAR-IMU odometry, NMEA GNSS, and map-to-odom fusion stack.</description>
  <maintainer email="maintainers@users.noreply.github.com">gicp_gnss_odom_localizer maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>diagnostic_aggregator</exec_depend>
  <exec_depend>pure_imu_undistortion</exec_depend>
  <exec_depend>pure_lidar_gyro_odometer</exec_depend>
  <exec_depend>pure_nmea_gnss_conversion</exec_depend>
  <exec_depend>pure_gnss_map_odom_fusion</exec_depend>
  <exec_depend>pure_autoware_localization_adapter</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
